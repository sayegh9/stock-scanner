{
    "api_keys": {
        "openai": "sk-your-openai-api-key-here",
        "anthropic": "sk-ant-your-claude-api-key-here",
        "zhipu": "your-zhipu-api-key-here",
        "finnhub": "your-finnhub-api-key-here",
        "newsdata": "your-newsdata-api-key-here",
        "notes": "Enter your API keys; configure at least one AI provider and optionally news providers."
    },
    "ai": {
        "model_preference": "openai",
        "models": {
            "openai": "gpt-4o-mini",
            "anthropic": "claude-3-haiku-20240307",
            "zhipu": "chatglm_turbo"
        },
        "max_tokens": 4000,
        "temperature": 0.7,
        "api_base_urls": {
            "openai": "https://api.openai.com/v1",
            "notes": "Update the URL above if you use a proxy API service."
        }
    },
    "analysis_weights": {
        "technical": 0.4,
        "fundamental": 0.4,
        "sentiment": 0.2,
        "notes": "The weights must add up to 1.0."
    },
    "cache": {
        "price_hours": 1,
        "fundamental_hours": 6,
        "news_hours": 2
    },
    "streaming": {
        "enabled": true,
        "show_thinking": false,
        "delay": 0.05
    },
    "analysis_params": {
        "max_news_count": 100,
        "technical_period_days": 180,
        "financial_indicators_count": 25
    },
    "markets": {
        "a_stock": {
            "enabled": false,
            "currency": "CNY",
            "timezone": "Asia/Shanghai",
            "trading_hours": "09:30-15:00",
            "notes": "China A-share market (disabled)"
        },
        "hk_stock": {
            "enabled": false,
            "currency": "HKD",
            "timezone": "Asia/Hong_Kong",
            "trading_hours": "09:30-16:00",
            "notes": "Hong Kong stock market (disabled)"
        },
        "us_stock": {
            "enabled": true,
            "currency": "USD",
            "timezone": "America/New_York",
            "trading_hours": "09:30-16:00",
            "notes": "Primary U.S. stock market configuration"
        }
    },
    "web_auth": {
        "enabled": false,
        "password": "",
        "session_timeout": 3600,
        "notes": "Optional password authentication for the web UI."
    },
    "_metadata": {
        "version": "3.1.0-multi-market-streaming",
        "description": "Enhanced AI stock analysis system configuration (U.S. equities + AI streaming output)",
        "last_updated": "2024-01-15"
    }
}
